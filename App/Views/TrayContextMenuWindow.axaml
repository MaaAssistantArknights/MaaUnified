<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MAAUnified.App.Controls"
        x:Class="MAAUnified.App.Views.TrayContextMenuWindow"
        Background="Transparent"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True">
  <StackPanel Orientation="Horizontal">
    <controls:AppPopupMenuPresenter x:Name="MenuPresenter"
                                    ItemInvoked="OnMenuItemInvoked"
                                    SubmenuInvoked="OnSubmenuInvoked"
                                    DismissRequested="OnMenuDismissRequested" />
    <controls:AppPopupMenuPresenter x:Name="SubmenuPresenter"
                                    Margin="4,0,0,0"
                                    IsVisible="False"
                                    ItemInvoked="OnMenuItemInvoked" />
  </StackPanel>
</Window>
