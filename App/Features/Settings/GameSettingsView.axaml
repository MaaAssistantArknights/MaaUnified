<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MAAUnified.App.Controls"
             xmlns:vm="clr-namespace:MAAUnified.App.ViewModels.Settings"
             Classes="settings-page"
             x:Class="MAAUnified.App.Features.Settings.GameSettingsView">
  <Grid Margin="4"
        RowDefinitions="Auto,*">
    <TextBlock Classes="settings-page-title"
               Text="{Binding RootTexts[Settings.Section.Game]}" />

    <controls:AdaptiveSpacingStackPanel Grid.Row="1"
                Margin="{DynamicResource MAA.Thickness.Settings.SectionTopMargin}"
                Classes="settings-page-flow">
      <Grid Classes="settings-page-labeled-row"
            controls:SettingsLabelWidthCoordinator.GroupKey="Game.Main"
            ColumnDefinitions="Auto,*">
        <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.ClientType]}" />
        <controls:AppSelect Grid.Column="1"
                  Classes="settings-select"
                  Width="{DynamicResource MAA.Size.Settings.FieldInputWidth}"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding IsSessionIdle}"
                  ItemsSource="{Binding ConnectionGameSharedState.ClientTypeOptions}"
                  SelectedItem="{Binding ConnectionGameSharedState.SelectedClientTypeOption, Mode=TwoWay}">
          <controls:AppSelect.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionGameOptionItem">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </controls:AppSelect.ItemTemplate>
        </controls:AppSelect>
      </Grid>

      <Border Classes="settings-page-meta-block"
              IsVisible="{Binding ConnectionGameSharedState.IsYoStarEnClientType}">
        <controls:AdaptiveSpacingStackPanel Classes="settings-page-compact-flow">
          <TextBlock Classes="app-body"
                     Text="{Binding RootTexts[Settings.Game.YoStarResolutionGuide.Available]}"
                     TextWrapping="Wrap" />
          <Button Classes="app-button app-secondary"
                  HorizontalAlignment="Left"
                  Content="{Binding RootTexts[Settings.Game.YoStarResolutionGuide.Open]}"
                  Click="OnOpenYoStarResolutionGuideClick" />
        </controls:AdaptiveSpacingStackPanel>
      </Border>

      <Border Classes="settings-page-meta-block"
              IsVisible="{Binding ConnectionGameSharedState.ShowOverseasClientHint}">
        <controls:AdaptiveSpacingStackPanel Classes="settings-page-compact-flow">
          <TextBlock Classes="app-body"
                     Text="{Binding RootTexts[Settings.Game.OverseasClientHint]}"
                     TextWrapping="Wrap" />
          <Button Classes="app-button app-secondary"
                  HorizontalAlignment="Left"
                  Content="{Binding RootTexts[Settings.Game.OverseasAdaptationGuide.Open]}"
                  Click="OnOpenOverseasAdaptationGuideClick" />
        </controls:AdaptiveSpacingStackPanel>
      </Border>

      <CheckBox Classes="app-checkbox"
                Content="{Binding RootTexts[Settings.Game.DeploymentWithPause]}"
                IsChecked="{Binding DeploymentWithPause}" />

      <Grid Classes="settings-page-labeled-row"
            controls:SettingsLabelWidthCoordinator.GroupKey="Game.Main"
            ColumnDefinitions="Auto,*">
        <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.StartsWithScript]}"
                                Tip="{Binding RootTexts[Settings.Game.StartsWithScriptTip]}" />
        <controls:AppTextInput Grid.Column="1"
                 Classes="settings-input"
                 Width="{DynamicResource MAA.Size.Settings.FieldPathWideWidth}"
                 HorizontalAlignment="Left"
                 DragDrop.AllowDrop="True"
                 DragDrop.DragOver="OnScriptPathDragOver"
                 DragDrop.Drop="OnStartsWithScriptDrop"
                 Text="{Binding StartsWithScript, UpdateSourceTrigger=LostFocus}" />
      </Grid>

      <Grid Classes="settings-page-labeled-row"
            controls:SettingsLabelWidthCoordinator.GroupKey="Game.Main"
            ColumnDefinitions="Auto,*">
        <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.EndsWithScript]}"
                                Tip="{Binding RootTexts[Settings.Game.EndsWithScriptTip]}" />
        <controls:AppTextInput Grid.Column="1"
                 Classes="settings-input"
                 Width="{DynamicResource MAA.Size.Settings.FieldPathWideWidth}"
                 HorizontalAlignment="Left"
                 DragDrop.AllowDrop="True"
                 DragDrop.DragOver="OnScriptPathDragOver"
                 DragDrop.Drop="OnEndsWithScriptDrop"
                 Text="{Binding EndsWithScript, UpdateSourceTrigger=LostFocus}" />
      </Grid>

      <Grid Classes="settings-page-two-column"
            ColumnDefinitions="Auto,12,Auto">
        <CheckBox Classes="app-checkbox"
                  Content="{Binding RootTexts[Settings.Game.UseScriptOnCopilot]}"
                  IsChecked="{Binding CopilotWithScript}" />
        <CheckBox Grid.Column="2"
                  Classes="app-checkbox"
                  Content="{Binding RootTexts[Settings.Game.UseScriptOnManualStop]}"
                  IsChecked="{Binding ManualStopWithScript}" />
      </Grid>

      <Grid Classes="settings-page-two-column"
            ColumnDefinitions="Auto,24,Auto">
        <CheckBox Classes="app-checkbox"
                  Content="{Binding RootTexts[Settings.Game.BlockSleep]}"
                  IsChecked="{Binding BlockSleep}" />
        <CheckBox Grid.Column="2"
                  Classes="app-checkbox"
                  Content="{Binding RootTexts[Settings.Game.BlockSleepWithScreenOn]}"
                  IsChecked="{Binding BlockSleepWithScreenOn}"
                  IsVisible="{Binding ShowBlockSleepWithScreenOnOption}" />
      </Grid>

      <CheckBox Classes="app-checkbox"
                Content="{Binding RootTexts[Settings.Game.EnableStallTimeout]}"
                IsChecked="{Binding EnableStallTimeout}" />

      <Grid Classes="settings-page-two-column"
            ColumnDefinitions="Auto,24,Auto">
        <Grid Classes="settings-page-labeled-row"
              controls:SettingsLabelWidthCoordinator.GroupKey="Game.Timeouts"
              ColumnDefinitions="Auto,*">
          <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.StallTimeoutMinutes]}" />
          <controls:AppNumberInput Grid.Column="1"
                                   Width="{DynamicResource MAA.Size.Settings.FieldNarrowWidth}"
                                   HorizontalAlignment="Left"
                                   IsEnabled="{Binding EnableStallTimeout}"
                                   Minimum="0"
                                   Maximum="11451"
                                   Value="{Binding StallTimeoutMinutes}" />
        </Grid>

        <Grid Grid.Column="2"
              Classes="settings-page-labeled-row"
              controls:SettingsLabelWidthCoordinator.GroupKey="Game.Timeouts"
              ColumnDefinitions="Auto,*">
          <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.ReminderIntervalMinutes]}" />
          <controls:AppNumberInput Grid.Column="1"
                                   Width="{DynamicResource MAA.Size.Settings.FieldNarrowWidth}"
                                   HorizontalAlignment="Left"
                                   Minimum="1"
                                   Maximum="11451"
                                   Value="{Binding ReminderIntervalMinutes}" />
        </Grid>
      </Grid>

      <CheckBox Classes="app-checkbox"
                Content="{Binding RootTexts[Settings.Game.EnableRunDurationLimit]}"
                IsChecked="{Binding EnableRunDurationLimit}"
                IsThreeState="True"
                ToolTip.Tip="{Binding RootTexts[Settings.Game.EnableRunDurationLimit.Tip]}" />

      <Grid Classes="settings-page-two-column"
            ColumnDefinitions="Auto,24,Auto"
            IsVisible="{Binding ShowRunDurationLimitOptions}">
        <Grid Classes="settings-page-labeled-row"
              controls:SettingsLabelWidthCoordinator.GroupKey="Game.RunDurationLimit"
              ColumnDefinitions="Auto,*">
          <controls:SettingsLabel Text="{Binding RootTexts[Settings.Game.RunDurationLimitMinutes]}" />
          <controls:AppNumberInput Grid.Column="1"
                                   Width="{DynamicResource MAA.Size.Settings.FieldNarrowWidth}"
                                   HorizontalAlignment="Left"
                                   Minimum="1"
                                   Maximum="11451"
                                   Value="{Binding RunDurationLimitMinutes}" />
        </Grid>

        <CheckBox Grid.Column="2"
                  Classes="app-checkbox"
                  Content="{Binding RootTexts[Settings.Game.RunDurationLimitExecutePostActions]}"
                  IsChecked="{Binding RunDurationLimitExecutePostActions}" />
      </Grid>
    </controls:AdaptiveSpacingStackPanel>
  </Grid>
</UserControl>
