<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MAAUnified.App.Controls"
             x:Class="MAAUnified.App.Features.Advanced.ToolboxMiniGameView">
  <UserControl.Styles>
    <Style Selector="StackPanel.toolbox-minigame-root-stack">
      <Setter Property="Spacing" Value="16" />
    </Style>

    <Style Selector="ScrollViewer.toolbox-minigame-scroll">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="StackPanel.toolbox-minigame-secretfront-stack">
      <Setter Property="Spacing" Value="12" />
    </Style>

    <Style Selector="TextBlock.toolbox-minigame-field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.App.Text.Secondary}" />
    </Style>

    <Style Selector="ComboBox.toolbox-minigame-selector">
      <Setter Property="MinWidth" Value="240" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.toolbox-minigame-context-text">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.Text.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.toolbox-minigame-category-text">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.Text.Secondary}" />
    </Style>

    <Style Selector="TextBlock.toolbox-minigame-tip-text">
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.Text.Secondary}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="Button.toolbox-minigame-action">
      <Setter Property="MinWidth" Value="136" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="toolbox-minigame-scroll"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Width="{DynamicResource MAA.Size.Toolbox.FormPanelWidth}"
                Margin="4,8"
                HorizontalAlignment="Center"
                Classes="toolbox-minigame-root-stack">
      <controls:AppSelect Classes="toolbox-minigame-selector"
                          IsEnabled="{Binding CanEditMiniGameOptions}"
                          ItemsSource="{Binding MiniGameTaskList}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding MiniGameTaskName}">
        <controls:AppSelect.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </controls:AppSelect.ItemTemplate>
      </controls:AppSelect>

      <StackPanel Spacing="2">
        <TextBlock Classes="toolbox-minigame-context-text"
                   Text="{Binding SelectedMiniGameEntry.Display}" />
        <TextBlock Classes="toolbox-minigame-category-text"
                   IsVisible="{Binding HasMiniGameCategory}"
                   Text="{Binding MiniGameCategoryText}" />
      </StackPanel>

      <StackPanel Classes="toolbox-minigame-secretfront-stack"
                  IsVisible="{Binding IsMiniGameSecretFront}"
                  IsEnabled="{Binding CanEditMiniGameOptions}">
        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding MiniGameEndingText}" />
          <controls:AppSelect Grid.Column="1"
                              Classes="toolbox-minigame-selector"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding MiniGameSecretFrontEndingOptions}"
                              SelectedItem="{Binding MiniGameSecretFrontEnding}" />
        </Grid>

        <Grid ColumnDefinitions="140,*">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding MiniGameEventPriorityText}" />
          <controls:AppSelect Grid.Column="1"
                              Classes="toolbox-minigame-selector"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding MiniGameSecretFrontEventOptions}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding MiniGameSecretFrontEvent}">
            <controls:AppSelect.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </controls:AppSelect.ItemTemplate>
          </controls:AppSelect>
        </Grid>
      </StackPanel>

      <StackPanel Classes="toolbox-minigame-secretfront-stack"
                  IsVisible="{Binding IsMiniGameReclamation}"
                  IsEnabled="{Binding CanEditMiniGameOptions}">
        <Grid ColumnDefinitions="180,*">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding ReclamationThemeText}" />
          <controls:AppSelect Grid.Column="1"
                              Classes="toolbox-minigame-selector"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding ReclamationThemeOptions}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReclamationTheme}">
            <controls:AppSelect.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </controls:AppSelect.ItemTemplate>
          </controls:AppSelect>
        </Grid>

        <Grid ColumnDefinitions="180,*">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding ReclamationModeText}" />
          <controls:AppSelect Grid.Column="1"
                              Classes="toolbox-minigame-selector"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding ReclamationModeOptions}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReclamationModeInputValue}">
            <controls:AppSelect.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              </DataTemplate>
            </controls:AppSelect.ItemTemplate>
          </controls:AppSelect>
        </Grid>

        <Grid ColumnDefinitions="180,*"
              IsVisible="{Binding IsReclamationArchiveMode}">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding ReclamationToolToCraftText}" />
          <controls:AppTextInput Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Text="{Binding ReclamationToolToCraft}" />
        </Grid>

        <Grid ColumnDefinitions="180,*">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding ReclamationIncrementModeText}" />
          <controls:AppSelect Grid.Column="1"
                              Classes="toolbox-minigame-selector"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding ReclamationIncrementModeOptions}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReclamationIncrementModeInputValue}">
            <controls:AppSelect.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </controls:AppSelect.ItemTemplate>
          </controls:AppSelect>
        </Grid>

        <Grid ColumnDefinitions="180,*"
              IsVisible="{Binding ShowReclamationArchiveSettings}">
          <TextBlock Classes="toolbox-minigame-field-label"
                     Text="{Binding ReclamationMaxCraftCountPerRoundText}" />
          <controls:AppTextInput Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Text="{Binding ReclamationMaxCraftCountPerRoundInput}" />
        </Grid>

        <CheckBox Classes="app-checkbox"
                  IsVisible="{Binding ShowReclamationClearStore}"
                  Content="{Binding ReclamationClearStoreText}"
                  IsChecked="{Binding ReclamationClearStore}" />
      </StackPanel>

      <CheckBox Classes="app-checkbox"
                IsVisible="{Binding IsMiniGameAutoRaisePotential}"
                IsEnabled="{Binding CanEditMiniGameOptions}"
                Content="{Binding AutoRaisePotentialUseNormalTokenText}"
                IsChecked="{Binding AutoRaisePotentialUseNormalToken}" />

      <StackPanel Classes="toolbox-minigame-secretfront-stack"
                  IsVisible="{Binding IsMiniGameEventShop}"
                  IsEnabled="{Binding CanEditMiniGameOptions}">
        <CheckBox Classes="app-checkbox"
                  Content="{Binding EventShopDataSupplementInstrumentText}"
                  IsChecked="{Binding EventShopBlackListDataSupplementInstrument}" />
        <CheckBox Classes="app-checkbox"
                  Content="{Binding EventShopDataSupplementStickText}"
                  IsChecked="{Binding EventShopBlackListDataSupplementStick}" />
        <CheckBox Classes="app-checkbox"
                  Content="{Binding EventShopLmdText}"
                  IsChecked="{Binding EventShopBlackListLmd}" />
        <CheckBox Classes="app-checkbox"
                  Content="{Binding EventShopFurniturePartText}"
                  IsChecked="{Binding EventShopBlackListFurniturePart}" />
        <CheckBox Classes="app-checkbox"
                  Content="{Binding EventShopOtherText}"
                  IsChecked="{Binding EventShopBlackListOther}" />
        <controls:AppTextInput IsVisible="{Binding EventShopBlackListOther}"
                               Watermark="{Binding EventShopOtherWatermark}"
                               Text="{Binding EventShopBlackList}" />
      </StackPanel>

      <TextBlock Classes="app-body long-wrap toolbox-minigame-tip-text"
                 Text="{Binding MiniGameTip}" />

      <Button Classes="app-button app-primary toolbox-minigame-action"
              Classes.locked="{Binding IsMiniGameRunning}"
              Content="{Binding MiniGameCommandText}"
              IsEnabled="{Binding CanStartMiniGame}"
              PointerEntered="OnMiniGameCommandPointerEntered"
              PointerExited="OnMiniGameCommandPointerExited"
              Click="OnMiniGameCommandClick" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
