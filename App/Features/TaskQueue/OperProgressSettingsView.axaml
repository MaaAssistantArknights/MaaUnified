<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MAAUnified.App.Controls"
             xmlns:vm="clr-namespace:MAAUnified.App.ViewModels.TaskQueue"
             x:Class="MAAUnified.App.Features.TaskQueue.OperProgressSettingsView">
  <UserControl.Styles>
    <Style Selector="StackPanel.oper-progress-section,
                     controls|AdaptiveSpacingStackPanel.oper-progress-section">
      <Setter Property="Spacing" Value="{DynamicResource MAA.App.Settings.PageCompactFlowSpacing}" />
    </Style>
    <Style Selector="StackPanel.oper-progress-card,
                     controls|AdaptiveSpacingStackPanel.oper-progress-card">
      <Setter Property="Spacing" Value="{DynamicResource MAA.App.Settings.PageToggleStackSpacing}" />
    </Style>
    <Style Selector="StackPanel.oper-progress-plan,
                     controls|AdaptiveSpacingStackPanel.oper-progress-plan">
      <Setter Property="Spacing" Value="{DynamicResource MAA.App.Settings.PageToggleStackSpacing}" />
    </Style>
    <Style Selector="TextBlock.oper-progress-note">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.oper-progress-move-button">
      <Setter Property="Width" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.App.SettingsInput.Chevron}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.oper-progress-move-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MAA.Brush.App.SettingsInput.GroupActionBackgroundHover}" />
      <Setter Property="Foreground" Value="{DynamicResource MAA.Brush.App.SettingsInput.ChevronHover}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto" Margin="2">
    <controls:AdaptiveSpacingStackPanel Classes="task-settings-section oper-progress-section">
      <Border Classes="app-surface app-card">
        <controls:AdaptiveSpacingStackPanel Classes="oper-progress-card">
          <TextBlock Classes="app-caption" Text="{Binding Texts[OperProgress.Plans]}" />

          <ItemsControl ItemsSource="{Binding Plans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OperProgressModuleViewModel+OperProgressPlanRow">
                <Border Classes="grouped-card-frame compact">
                  <controls:AdaptiveSpacingStackPanel Classes="oper-progress-plan">
                    <Grid ColumnDefinitions="Auto,*,Auto,4,Auto,4,Auto">
                      <TextBlock Grid.Column="0"
                                 Margin="0,0,6,0"
                                 Classes="app-caption"
                                 VerticalAlignment="Center"
                                 Text="{Binding Index}" />
                      <controls:AppTextInput Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Watermark="{Binding DataContext.OperatorNameWatermark, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <Button Grid.Column="2"
                              Classes="oper-progress-move-button"
                              Content="↑"
                              Tag="{Binding}"
                              ToolTip.Tip="{Binding DataContext.MoveUpText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Click="OnMovePlanUpClick" />
                      <Button Grid.Column="4"
                              Classes="oper-progress-move-button"
                              Content="↓"
                              Tag="{Binding}"
                              ToolTip.Tip="{Binding DataContext.MoveDownText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Click="OnMovePlanDownClick" />
                      <Button Grid.Column="6"
                              Classes="settings-dropdown-delete-button"
                              Tag="{Binding}"
                              ToolTip.Tip="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Click="OnRemovePlanClick" />
                    </Grid>

                    <TextBlock Classes="subtle oper-progress-note"
                               IsVisible="{Binding NameWarningVisible}"
                               Text="{Binding NameWarningText}" />

                    <Grid ColumnDefinitions="*,4,*">
                      <controls:AppSelect Grid.Column="0"
                                          ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding Role}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+RoleOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                      <controls:AppSelect Grid.Column="2"
                                          ItemsSource="{Binding DataContext.EliteOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding Elite}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+IntOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                    </Grid>

                    <Grid ColumnDefinitions="*,4,*">
                      <controls:AppSelect Grid.Column="0"
                                          ItemsSource="{Binding DataContext.SkillLevelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding SkillLevel}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+IntOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                      <controls:AppSelect Grid.Column="2"
                                          ItemsSource="{Binding DataContext.MasteryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding Mastery1}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+IntOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                    </Grid>

                    <Grid ColumnDefinitions="*,4,*">
                      <controls:AppSelect Grid.Column="0"
                                          ItemsSource="{Binding DataContext.MasteryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding Mastery2}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+IntOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                      <controls:AppSelect Grid.Column="2"
                                          ItemsSource="{Binding DataContext.MasteryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValueBinding="{Binding Value}"
                                          SelectedValue="{Binding Mastery3}">
                        <controls:AppSelect.ItemTemplate>
                          <DataTemplate x:DataType="vm:OperProgressModuleViewModel+IntOption">
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </controls:AppSelect.ItemTemplate>
                      </controls:AppSelect>
                    </Grid>
                  </controls:AdaptiveSpacingStackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="subtle oper-progress-note"
                     IsVisible="{Binding ShowEmptyHint}"
                     Text="{Binding EmptyHintText}" />

          <controls:SettingsInlineRow FieldWidth="{DynamicResource MAA.Size.Settings.FieldWideWidth}"
                                      controls:SettingsLabelWidthCoordinator.GroupKey="TaskQueue.Fields">
            <controls:SettingsLabel Text="{Binding OperatorNameText}"
                                    Tip="{Binding OperatorNameTip}" />
            <Grid ColumnDefinitions="*,4,*">
              <controls:AppTextInput Grid.Column="0"
                                     Text="{Binding NewPlanName, UpdateSourceTrigger=LostFocus}"
                                     Watermark="{Binding OperatorNameWatermark}" />
              <controls:AppSelect Grid.Column="2"
                                  ItemsSource="{Binding RoleOptions}"
                                  SelectedValueBinding="{Binding Value}"
                                  SelectedValue="{Binding NewPlanRole}">
                <controls:AppSelect.ItemTemplate>
                  <DataTemplate x:DataType="vm:OperProgressModuleViewModel+RoleOption">
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                  </DataTemplate>
                </controls:AppSelect.ItemTemplate>
              </controls:AppSelect>
            </Grid>
          </controls:SettingsInlineRow>

          <Button Classes="app-button app-secondary"
                  Content="{Binding AddPlanText}"
                  Click="OnAddPlanClick" />
        </controls:AdaptiveSpacingStackPanel>
      </Border>
    </controls:AdaptiveSpacingStackPanel>
  </Grid>
</UserControl>
