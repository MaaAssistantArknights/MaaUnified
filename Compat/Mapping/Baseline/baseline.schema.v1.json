{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MAAUnified.BaselineFreeze.v1",
  "title": "MAAUnified Baseline Freeze v1",
  "type": "object",
  "required": [
    "schema_version",
    "frozen_at_utc",
    "wpf_baseline_commit",
    "themes",
    "locales",
    "items",
    "config_key_mappings",
    "fallback_capabilities",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "frozen_at_utc": {
      "type": "string"
    },
    "wpf_baseline_commit": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "waiver": {
            "$ref": "#/$defs/waiver"
          },
          "waiver_scope": {
            "$ref": "#/$defs/waiver_scope"
          }
        }
      }
    },
    "config_key_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "owner_item_id",
          "parity_status",
          "priority",
          "notes",
          "evidence"
        ],
        "properties": {
          "mapping_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "read_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "write_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "waiver": {
            "$ref": "#/$defs/waiver"
          }
        }
      }
    },
    "fallback_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "waiver": {
            "$ref": "#/$defs/waiver"
          },
          "waiver_scope": {
            "$ref": "#/$defs/waiver_scope"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "feature_item_count",
        "system_item_count",
        "config_key_count",
        "wpf_config_key_count",
        "avalonia_extension_config_key_count",
        "wpf_config_key_set_sha256",
        "fallback_record_count"
      ],
      "properties": {
        "wpf_config_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "avalonia_extension_config_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "wpf_config_key_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "waiver": {
      "type": "object",
      "required": [
        "owner",
        "reason",
        "expires_on",
        "alternative_validation"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expires_on": {
          "type": "string"
        },
        "alternative_validation": {
          "type": "string"
        }
      }
    },
    "waiver_scope": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
