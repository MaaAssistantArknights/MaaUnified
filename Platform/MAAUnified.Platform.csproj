<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MaaUnifiedWindowsToastBuild>false</MaaUnifiedWindowsToastBuild>
    <MaaUnifiedWindowsToastBuild Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifiers)' == 'win-x64' Or '$(RuntimeIdentifiers)' == 'win-arm64' Or '$(RuntimeIdentifiers)' == 'win-x86'">true</MaaUnifiedWindowsToastBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compat\MAAUnified.Compat.csproj" />
    <Compile Include="..\Build\BuildFlavor.cs" Link="Shared\BuildFlavor.cs" />
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref"
                     Version="[10.0.17763.57]"
                     Condition="'$(MaaUnifiedWindowsToastBuild)' == 'true'" />
    <PackageReference Include="SharpHook" Version="7.1.1" />
    <PackageReference Include="DesktopNotifications" Version="1.3.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(MaaUnifiedWindowsToastBuild)' == 'true'">
    <None Include="$(NuGetPackageRoot)microsoft.toolkit.uwp.notifications/7.1.3/lib/net5.0-windows10.0.17763/Microsoft.Toolkit.Uwp.Notifications.dll"
          Link="MAAUnified.WindowsToast.Toolkit.dll"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.17763.57/lib/net8.0/Microsoft.Windows.SDK.NET.dll"
          Link="Microsoft.Windows.SDK.NET.dll"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.17763.57/lib/net8.0/WinRT.Runtime.dll"
          Link="WinRT.Runtime.dll"
          ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
